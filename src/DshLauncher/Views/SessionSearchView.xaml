<UserControl x:Class="DshLauncher.Views.SessionSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 跨会话搜索浮层（Ctrl+F）：官方 session.search -->
    <Border Background="{DynamicResource Brush.Card}" CornerRadius="12" BorderBrush="#804C8DFF" BorderThickness="1"
            Padding="16" MaxWidth="620" MaxHeight="520" Margin="40">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="420"
                         VerticalAlignment="Center" FontSize="14" ToolTip="跨会话搜对话内容，回车搜索"
                         KeyDown="Search_KeyDown"/>
                <Button Content="搜索" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                        Padding="16,7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Content="✕" Command="{Binding CloseCommand}" Padding="10,7" Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Results}" Margin="0,10,0,0" MaxHeight="360">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Snippet}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding SessionId}" FontFamily="Consolas" FontSize="10"
                                           Foreground="{DynamicResource Brush.Text.Dim}" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="复制" FontSize="11" Padding="8,3"
                                            Command="{Binding DataContext.CopyResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="打开" FontSize="11" Padding="8,3" Margin="8,0,0,0"
                                            Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
