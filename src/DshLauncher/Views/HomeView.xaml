<UserControl x:Class="DshLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DshLauncher.Controls"
             xmlns:vm="clr-namespace:DshLauncher.ViewModels">
    <!-- 启动页 · 合并为一张紧凑主卡（状态/信息/大按钮/环形/统计/一言），导出与会话树两张保留 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Style="{StaticResource PageHeader}" Text="启动"/>

            <!-- 主卡：状态 + 信息 + 大按钮 + 停止/重启 + 环形 + 统计 + 一言 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <!-- 顶行：状态 + 信息（头像/名称/版本/模型/端口） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Brush.Surface.Hover}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/app-brand.png" Width="28" Height="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeepSeek Harness" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Secondary}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="v{0} · {1}">
                                        <Binding Path="DshVersion"/>
                                        <Binding Path="DshModel"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="260">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="20,2,0,0" TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- 大按钮 -->
                    <Button Content="{Binding BigButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Foreground="White" FontSize="18" FontWeight="Bold"
                            Height="54" Margin="0,16,0,0"
                            Command="{Binding BigButtonCommand}"
                            IsEnabled="{Binding IsBigButtonEnabled}"/>

                    <!-- 停止/重启 + CPU/内存环形 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="停止" Style="{StaticResource GrayButton}"
                                    Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,0"/>
                            <Button Content="重启" Style="{StaticResource GrayButton}"
                                    Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestart}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ctl:RingProgress Percent="{Binding CpuPercent}" Label="CPU" Size="68"/>
                            <ctl:RingProgress Percent="{Binding MemoryPercent}" Label="内存" Size="68" Margin="18,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 统计行：会话 / 工作区 / 运行时长 -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="10" Padding="14,11" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="会话" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Text="{Binding SessionCount}" FontSize="24" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="10" Padding="14,11" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="工作区" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Text="{Binding WorkspaceCount}" FontSize="24" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="10" Padding="14,11">
                            <StackPanel>
                                <TextBlock Text="运行时长" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock Text="{Binding Uptime}" FontSize="24" FontWeight="Bold" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 一言 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Surface.Hover}" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/app-brand.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Quote}" FontSize="13" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="—— " Foreground="{DynamicResource Brush.Text.Dim}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding QuoteAuthor}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Command="{Binding RandomQuoteCommand}" Padding="7,4" Margin="12,0,0,0" ToolTip="换一句">
                                <Grid Width="15" Height="15">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                               Visibility="{Binding IsQuoteLoading, Converter={StaticResource InvertBoolToVis}}"/>
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" FontWeight="Bold"
                                               Visibility="{Binding IsQuoteLoading, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Button Command="{Binding CopyQuoteCommand}" Padding="7,4" Margin="4,0,0,0" ToolTip="复制">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 错误提示 -->
                    <Border Background="#22EF4444" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Accent.Red}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#22EF4444" CornerRadius="8" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding HasOpenError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding OpenError}" Foreground="{DynamicResource Brush.Accent.Red}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 会话导出卡（A3）：选会话导出 Markdown -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="会话导出" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding Export.RefreshCommand}"
                                Padding="10,4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Export.Status}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox ItemsSource="{Binding Export.Sessions}"
                                  SelectedItem="{Binding Export.SelectedSession}"
                                  DisplayMemberPath="Display" Width="340" FontSize="13" VerticalAlignment="Center"/>
                        <Button Content="导出 Markdown" Style="{StaticResource PrimaryButton}"
                                Command="{Binding Export.ExportCommand}" Padding="16,7" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="打开会话" Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Export.SelectedSession.Hit.SessionId}"
                                IsEnabled="{Binding Export.HasSelectedSession}"
                                Padding="16,7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 工作区会话树看板（A4）：工作区 → 会话两层级联 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="工作区会话树" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding SessionTree.RefreshCommand}"
                                Padding="10,4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding SessionTree.Status}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TreeView ItemsSource="{Binding SessionTree.Workspaces}" MaxHeight="280" Margin="0,10,0,0"
                              BorderBrush="{DynamicResource Brush.Border}" Background="Transparent" Padding="4">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:WorkspaceNode}" ItemsSource="{Binding Sessions}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" FontSize="12"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionLeaf}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StateDot}" FontSize="11"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Margin="6,0,0,0" MaxWidth="320"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Session.SessionId}" Foreground="{DynamicResource Brush.Text.Dim}" FontSize="10"
                                               Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Session.SessionId}"/>
                                    <Button Content="打开" FontSize="11" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Session.SessionId}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
