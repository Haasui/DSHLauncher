<UserControl x:Class="DshLauncher.Views.PluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PageHeader}" Text="插件" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#14000000" CornerRadius="20" Padding="10,4"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HealthText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="自检" Command="{Binding SelfCheckCommand}" Margin="0,0,8,0"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <TabControl BorderThickness="0" Background="Transparent">
                <!-- 插件市场 -->
                <TabItem Header="插件市场">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding StoreQuery, UpdateSourceTrigger=PropertyChanged}" Width="280"
                                         VerticalAlignment="Center" ToolTip="输入关键词，如 web 或 memory；留空列出全部 dsh-plugin 仓库"/>
                                <Button Content="搜索" Command="{Binding SearchStoreCommand}" Margin="8,0,0,0"/>
                                <TextBlock Text="排序" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding StoreSortOptions}" SelectedItem="{Binding SelectedStoreSort}"
                                          Width="100" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 分类（真实 gitHub topics 聚合） -->
                            <ItemsControl ItemsSource="{Binding StoreCategories}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SearchCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" FontSize="12" Padding="12,4" Margin="0,0,8,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 手动安装（任意 npm 包 / git 仓库） -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="或手动安装" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding InstallSource, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                         Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="npm 包名，或 git 地址 github:user/repo"/>
                                <Button Content="安装" Command="{Binding InstallCommand}" Margin="10,0,0,0" Padding="14,6"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StoreStatus}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding StoreResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI"/>
                                                            <TextBlock Text="{Binding VersionBadge}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding StarText}" Foreground="#F5A623" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                            <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.Text.Dim}"/>
                                                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource Brush.Text.Dim}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                   FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        <ItemsControl ItemsSource="{Binding TopicTags}" Margin="0,5,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#22000000" CornerRadius="8" Padding="7,2" Margin="0,0,6,2">
                                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Content="GitHub 文档" Command="{Binding OpenRepoCommand}"
                                                                Visibility="{Binding HasRepository, Converter={StaticResource BoolToVis}}"
                                                                FontSize="12" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Content="{Binding InstallButtonText}"
                                                                Command="{Binding DataContext.InstallFromStoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" IsEnabled="{Binding CanInstall}"
                                                                Style="{StaticResource GreenButton}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="加载更多" Command="{Binding LoadMoreStoreCommand}"
                                    Visibility="{Binding HasMoreStoreResults, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Padding="18,7" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- 本地插件 -->
                <TabItem Header="本地插件">
                    <StackPanel Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource Brush.Surface.Hover}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                                                <Image Source="{Binding IconUri}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                                    <Border Background="{Binding BadgeBrush}" CornerRadius="10" Padding="8,1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text=" v" Foreground="{DynamicResource Brush.Text.Dim}" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Version}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="文档" Command="{Binding DataContext.OpenPluginRepoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                        Visibility="{Binding HasRepository, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="更新" Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" Padding="10,6" FontSize="12"
                                                        IsEnabled="{Binding Isolated, Converter={StaticResource InvertBool}}"/>
                                                <Button Content="修复依赖" Command="{Binding DataContext.FixDepsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,10,0" Padding="10,6" FontSize="12"/>
                                                <Button Content="卸载" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,10,0" Padding="10,6" FontSize="12"/>
                                                <ToggleButton Style="{StaticResource Switch}"
                                                              IsChecked="{Binding Isolated, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleIsolateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
