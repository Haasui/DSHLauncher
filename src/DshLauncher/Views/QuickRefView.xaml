<UserControl x:Class="DshLauncher.Views.QuickRefView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Style="{StaticResource PageHeader}" Text="速查"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="常用 dsh 命令 + Prompt 模板，支持搜索，点「复制」即复制到剪贴板。"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="320"
                         VerticalAlignment="Center" ToolTip="搜索命令/模板，如 web、插件、评审"/>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Accent.Blue}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding FilteredGroups}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="8" Padding="12,10"
                                                    Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Content}" FontFamily="Consolas, Microsoft YaHei UI"
                                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                        <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                   FontSize="11" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="复制" Padding="12,5" Margin="10,0,0,0" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
